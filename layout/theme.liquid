    <a class="skip-to-content-link visually-hidden" href="#MainContent">{{ "accessibility.skip_to_text" | t }}</a>
    <div class="t4s-close-overlay t4s-op-0"></div>

    <div class="t4s-website-wrapper">
      {%- render 'header', t_name: t_name -%}

      <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
        {{ content_for_layout }}
      </main>
      <footer id="t4s-footer">
        {%- section 'footer-top' -%}
        {%- section 'footer' -%}
        {%- section 'footer-bottom' -%}
      </footer>
    </div>

      <ul hidden class="t4s-d-none">
        <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      </ul>
    {%- render 'render_bottom' -%}
    {%- render 'judgeme-lazy' -%}
    {%- if request.design_mode -%}
    <script>
    /* Editor only: reliable quickview preview */
    (function(){
      function extractQV(html){
        try {
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var tpl = doc.querySelector('template');
          if (tpl && tpl.innerHTML) return tpl.innerHTML;
        } catch(e) {}
        return html;
      }
      function initQV(){
        try {
          var modal = document.querySelector('.t4s-modal');
          var scope = modal || document;
          var feat = scope.querySelector('[data-product-featured]');
          if (feat && window.T4SThemeSP && T4SThemeSP.Product) { new T4SThemeSP.Product(feat); }
        } catch(e) {}
        try {
          var modal2 = document.querySelector('.t4s-modal');
          var media = (modal2 || document).querySelector('[data-main-media].flickityt4s:not(.flickityt4s-enabled)');
          if (media && window.T4SThemeSP && T4SThemeSP.Carousel) { media.flickityt4s = new T4SThemeSP.Carousel(media); }
        } catch(e) {}
        try { T4SThemeSP.PopupMFP && T4SThemeSP.PopupMFP(); } catch(e) {}
        try { T4SThemeSP.initGroupsProduct && T4SThemeSP.initGroupsProduct(); } catch(e) {}
        try { window.Shopify && Shopify.PaymentButton && Shopify.PaymentButton.init(); } catch(e) {}
        try { T4SThemeSP.Wishlist && T4SThemeSP.Wishlist.updateAll(); } catch(e) {}
        try { T4SThemeSP.Compare && T4SThemeSP.Compare.updateAll(); } catch(e) {}
        try { T4SThemeSP.ProductItem && T4SThemeSP.ProductItem.reloadReview && T4SThemeSP.ProductItem.reloadReview(); } catch(e) {}
        try { T4SThemeSP.Tooltip && T4SThemeSP.Tooltip(); } catch(e) {}
      }
      function openQV(href){
        if (!href || !(window.jQuery && window.T4SThemeSP && T4SThemeSP.NTpopupInline)) return;
        var url = href + ((href.indexOf('?') > -1 || href.indexOf('&') > -1) ? '&' : '/?') + 'section_id=main-qv';
        fetch(url).then(function(r){ return r.text(); }).then(function(html){
          var content = extractQV(html);
          if (!content) return;
          T4SThemeSP.NTpopupInline(content, 'main-qv', initQV, 't4s-opening-qv');
          try { jQuery(document.body).trigger('modalt4s:opened'); } catch(e) {}
          try { jQuery(document).trigger('modalt4s:opened'); } catch(e) {}
        }).catch(function(e){ if (window.console) console.log(e); });
      }
      document.addEventListener('click', function(e){
        var t = e.target;
        var btn = (t && t.closest) ? t.closest('[data-action-quickview]') : null;
        if (!btn) return;
        e.preventDefault();
        e.stopPropagation();
        openQV(btn.getAttribute('href'));
      }, true);
    })();
    /* Editor only: re-init components after section reload so unsaved changes show without Save */
    (function(){
      function initSection(scope){
        if (!scope || !window.T4SThemeSP) return;
        try {
          var sliders = scope.querySelectorAll('.flickityt4s:not(.flickityt4s-enabled)');
          sliders.forEach(function(el){ try { el.flickityt4s = new T4SThemeSP.Carousel(el); } catch(e){} });
        } catch(e) {}
        try { T4SThemeSP.Countdown && T4SThemeSP.Countdown(); } catch(e) {}
        try { if (typeof T4SThemeSP.reinitProductGridItem === 'function') T4SThemeSP.reinitProductGridItem(); } catch(e) {}
        try { T4SThemeSP.PopupMFP && T4SThemeSP.PopupMFP(); } catch(e) {}
        try { T4SThemeSP.Tooltip && T4SThemeSP.Tooltip(); } catch(e) {}
        try { T4SThemeSP.Header && T4SThemeSP.Header.stickyInit && T4SThemeSP.Header.stickyInit(); } catch(e) {}
        try {
          if (window.jQuery) { jQuery(window).trigger('resize'); }
          else { window.dispatchEvent(new Event('resize')); }
        } catch(e) {}
      }
      ['shopify:section:load', 'shopify:section:reorder', 'shopify:block:select'].forEach(function(ev){
        document.addEventListener(ev, function(e){ initSection(e.target); });
      });
    })();
    </script>
    {%- endif -%}
  </body>
</html>
